{
  "name": "agent-stream",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "engine",
    "web",
    "extension"
  ],
  "scripts": {
    "build": "npm run build -w web && npm run build -w extension",
    "package": "npm run build && npm run package -w extension",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
