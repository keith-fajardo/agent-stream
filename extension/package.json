{
  "name": "agent-stream",
  "displayName": "Agent Stream",
  "description": "Co-create a workflow graph with an AI planner and run it step by step on your own AI subscription: Claude, GitHub Copilot or OpenAI Codex.",
  "keywords": ["ai", "agent", "workflow", "planner", "claude", "copilot", "codex", "openai"],
  "version": "0.9.0",
  "publisher": "keithfajardo",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/keith-fajardo/agent-stream.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:.agent-stream/graphs/*.md",
    "workspaceContains:.agent-stream/graphs/*.json"
  ],
  "contributes": {
    "configuration": {
      "title": "Agent Stream",
      "properties": {
        "agentStream.provider": {
          "type": "string",
          "enum": ["claude", "copilot", "codex"],
          "default": "claude",
          "enumDescriptions": [
            "Claude: your Claude subscription through Claude Code.",
            "GitHub Copilot: your Copilot plan through VS Code's Language Model API.",
            "OpenAI Codex: your ChatGPT subscription through the Codex CLI."
          ],
          "description": "The AI provider that runs agent steps and the planner."
        },
        "agentStream.claudePath": {
          "type": "string",
          "default": "",
          "description": "Full path to Claude Code (claude, or claude.exe on Windows). Leave empty to find it automatically. Claude provider only."
        },
        "agentStream.codexPath": {
          "type": "string",
          "default": "",
          "description": "Full path to the Codex CLI (codex, or codex.exe or codex.cmd on Windows). Leave empty to find it automatically. OpenAI Codex provider only."
        },
        "agentStream.gitBashPath": {
          "type": "string",
          "default": "",
          "description": "Windows only: full path to Git Bash (bash.exe), used for command steps. Leave empty to find it automatically."
        },
        "agentStream.model": {
          "type": "string",
          "default": "",
          "description": "The model agent steps in runs use, and planner conversations that haven't chosen their own (an alias such as sonnet, or a full model id). Leave empty for the provider's default (Claude Code's default; Auto on Copilot; Codex's default model on Codex). Agent Stream: Select Model lists the models."
        },
        "agentStream.effort": {
          "type": "string",
          "enum": ["", "low", "medium", "high", "xhigh", "max", "ultra"],
          "default": "",
          "enumDescriptions": [
            "Default: the model's own effort level.",
            "Low", "Medium", "High", "Extra high", "Max", "Ultra"
          ],
          "description": "The effort level for agent steps in runs and for planner conversations that haven't chosen their own. Leave empty for the model's default. Ignored for a model that doesn't offer the level."
        },
        "agentStream.maxParallel": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 16,
          "description": "How many steps of a run may run at the same time."
        },
        "agentStream.copilot.maxRequestsPerStep": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 200,
          "description": "GitHub Copilot: the most model requests one agent step may make. A step that reaches it stops and says so."
        },
        "agentStream.copilot.maxRequestsPerTurn": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 100,
          "description": "GitHub Copilot: the most model requests one planner chat message may make."
        },
        "agentStream.browser.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Full path to Chrome, Edge or Chromium for the Agent Stream browser. Leave empty to find it automatically. A user or machine setting only: a workspace can't set it, since the browser holds your logins."
        },
        "agentStream.browser.searchEngine": {
          "type": "string",
          "default": "https://www.google.com/search?q=",
          "description": "The search page browser steps use: a web address the URL-encoded query is appended to."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "agentStream.graph",
        "displayName": "Agent Stream Graph",
        "selector": [
          {
            "filenamePattern": "**/.agent-stream/graphs/*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentStream",
          "title": "Agent Stream",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "agentStreamChat",
          "title": "Agent Stream Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentStream": [
        {
          "id": "agentStream.sessions",
          "name": "Sessions"
        },
        {
          "id": "agentStream.graphs",
          "name": "Graphs"
        },
        {
          "id": "agentStream.approvals",
          "name": "Approvals"
        }
      ],
      "agentStreamChat": [
        {
          "type": "webview",
          "id": "agentStream.chat",
          "name": "Chat"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentStream.graphs",
        "contents": "Open a folder to use Agent Stream.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "agentStream.graphs",
        "contents": "No graphs yet.\n[New Graph](command:agentStream.newGraph)\n[Import Graph](command:agentStream.importGraph)",
        "when": "workbenchState != empty"
      },
      {
        "view": "agentStream.approvals",
        "contents": "Nothing is waiting for approval."
      }
    ],
    "commands": [
      {
        "command": "agentStream.selectProvider",
        "title": "Select Provider",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.selectModel",
        "title": "Select Model",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.retrySignIn",
        "title": "Check Again",
        "category": "Agent Stream",
        "icon": "$(refresh)"
      },
      {
        "command": "agentStream.signInDetails",
        "title": "Show Sign-in Details",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.newGraph",
        "title": "New Graph",
        "category": "Agent Stream",
        "icon": "$(add)"
      },
      {
        "command": "agentStream.openGraph",
        "title": "Open Graph",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.importGraph",
        "title": "Import Graph",
        "category": "Agent Stream",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentStream.exportGraph",
        "title": "Export Graph",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.exportRunReport",
        "title": "Export Run Report",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.openGraphMarkdown",
        "title": "Open Graph as Markdown",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.renameGraph",
        "title": "Rename Graph",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.duplicateGraph",
        "title": "Duplicate Graph",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.moveGraph",
        "title": "Move to Session…",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.deleteGraph",
        "title": "Delete Graph",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.setUpParallelTickets",
        "title": "Set Up Parallel Tickets",
        "category": "Agent Stream",
        "icon": "$(git-branch)"
      },
      {
        "command": "agentStream.newAbTestGraph",
        "title": "New A/B Test Graph",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.manageRunWorkspaces",
        "title": "Manage Run Workspaces",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.runGraph",
        "title": "Run Graph",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.stopRun",
        "title": "Stop Run",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.editVariables",
        "title": "Edit Variables",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.approveAll",
        "title": "Approve All",
        "category": "Agent Stream",
        "icon": "$(check-all)"
      },
      {
        "command": "agentStream.approve",
        "title": "Approve",
        "category": "Agent Stream",
        "icon": "$(check)"
      },
      {
        "command": "agentStream.deny",
        "title": "Deny",
        "category": "Agent Stream",
        "icon": "$(close)"
      },
      {
        "command": "agentStream.revealApproval",
        "title": "Show Step",
        "category": "Agent Stream",
        "icon": "$(eye)"
      },
      {
        "command": "agentStream.showSidebar",
        "title": "Show Sidebar",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.focusChat",
        "title": "Show Chat",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.newSession",
        "title": "New Session",
        "category": "Agent Stream",
        "icon": "$(add)"
      },
      {
        "command": "agentStream.switchSession",
        "title": "Switch Session",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.renameSession",
        "title": "Rename Session",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.duplicateSession",
        "title": "Duplicate Session",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.deleteSession",
        "title": "Delete Session",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.openBrowser",
        "title": "Open Browser",
        "category": "Agent Stream"
      },
      {
        "command": "agentStream.clearBrowserData",
        "title": "Clear Browser Data",
        "category": "Agent Stream"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentStream.newGraph",
          "when": "view == agentStream.graphs",
          "group": "navigation@1"
        },
        {
          "command": "agentStream.importGraph",
          "when": "view == agentStream.graphs",
          "group": "navigation@2"
        },
        {
          "command": "agentStream.setUpParallelTickets",
          "when": "view == agentStream.graphs",
          "group": "navigation@3"
        },
        {
          "command": "agentStream.approveAll",
          "when": "view == agentStream.approvals",
          "group": "navigation"
        },
        {
          "command": "agentStream.newSession",
          "when": "view == agentStream.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentStream.openGraph",
          "when": "view == agentStream.graphs && viewItem == graph",
          "group": "1_open@1"
        },
        {
          "command": "agentStream.openGraphMarkdown",
          "when": "view == agentStream.graphs && viewItem =~ /^graph/",
          "group": "1_open@2"
        },
        {
          "command": "agentStream.renameGraph",
          "when": "view == agentStream.graphs && viewItem == graph",
          "group": "2_edit@1"
        },
        {
          "command": "agentStream.duplicateGraph",
          "when": "view == agentStream.graphs && viewItem == graph",
          "group": "2_edit@2"
        },
        {
          "command": "agentStream.moveGraph",
          "when": "view == agentStream.graphs && viewItem == graph",
          "group": "2_edit@3"
        },
        {
          "command": "agentStream.exportGraph",
          "when": "view == agentStream.graphs && viewItem == graph",
          "group": "3_share@1"
        },
        {
          "command": "agentStream.deleteGraph",
          "when": "view == agentStream.graphs && viewItem =~ /^graph/",
          "group": "4_delete@1"
        },
        {
          "command": "agentStream.approve",
          "when": "view == agentStream.approvals && viewItem == approval",
          "group": "inline@1"
        },
        {
          "command": "agentStream.deny",
          "when": "view == agentStream.approvals && viewItem == approval",
          "group": "inline@2"
        },
        {
          "command": "agentStream.revealApproval",
          "when": "view == agentStream.approvals && viewItem == graphChange",
          "group": "inline@1"
        },
        {
          "command": "agentStream.deny",
          "when": "view == agentStream.approvals && viewItem == graphChange",
          "group": "inline@2"
        },
        {
          "command": "agentStream.revealApproval",
          "when": "view == agentStream.approvals && viewItem == browserApproval",
          "group": "inline@1"
        },
        {
          "command": "agentStream.deny",
          "when": "view == agentStream.approvals && viewItem == browserApproval",
          "group": "inline@2"
        },
        {
          "command": "agentStream.renameSession",
          "when": "view == agentStream.sessions && viewItem == session",
          "group": "2_edit@1"
        },
        {
          "command": "agentStream.duplicateSession",
          "when": "view == agentStream.sessions && viewItem == session",
          "group": "2_edit@2"
        },
        {
          "command": "agentStream.deleteSession",
          "when": "view == agentStream.sessions && viewItem =~ /^session/",
          "group": "4_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentStream.approve",
          "when": "false"
        },
        {
          "command": "agentStream.deny",
          "when": "false"
        },
        {
          "command": "agentStream.revealApproval",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:all": "cd .. && npm run build",
    "package": "vsce package --no-dependencies && node scripts/check-vsix.mjs",
    "test": "vitest run",
    "test:integration": "npm run build:all && node test/integration/runTest.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@agent-stream/engine": "*",
    "@agent-stream/shared": "*"
  },
  "devDependencies": {
    "@types/vscode": "~1.106.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
